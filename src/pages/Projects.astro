---
import Layout from "@/layouts/Layout.astro"
import { Image } from "astro:assets"
import crater0 from "../assets/crater0.png"
import crater1 from "../assets/crater1.png"
import keeb0 from "../assets/split_keyboard.jpeg"
import devboard0 from "../assets/3d-render.png"
import car0 from "../assets/car.png"
import macropad0 from "../assets/macropad.jpeg"
import robotarm0 from "../assets/robotarm.jpg"
import emfi from "../assets/emfi.png"
import quadcopter from "../assets/quadcopter.png"
import bootloader from "../assets/bootloader.png"
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
---

<Layout>
</Layout>
<!doctype html>
<html lang="en">
    <body>
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 p-8">
            <div class="break-inside-avoid mb-6">
                <a href="https://github.com/nano13579/crater">
                    <Card className="bg-darkblue w-auto border border-4 hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>A Multi-Effects Unit Guitar Pedal</CardTitle>
                            <CardDescription>In Progress</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Image src={ crater1 } alt="schematic crater" class="rounded-lg"/>
                        </CardContent>
                        <CardFooter>
                            <p>Employs the STM32H743 as its DSP. Uses the PCM3060 codec, 8 MB of SDRAM, 32 MB of QSPI flash
                                and dual op amps for pre & post processing</p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href=https://github.com/nano13579/vga-output>
                    <Card className="bg-darkblue w-auto border border-4 hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>FPGA Design for VGA Graphical Output</CardTitle>
                            <CardDescription>In Progress</CardDescription>
                        </CardHeader>
                        <CardFooter>
                            <p>FPGA design for VGA output, simulated using Verilator 
                                and SDL to represent the iCE40UP5K FPGA during testing</p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href= https://github.com/nano13579/banana-split>
                    <Card className="bg-darkblue w-auto hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>Custom Split Keyboard</CardTitle>
                            <CardDescription>Completed - October 2025</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Image src={ keeb0 } alt="split keeb" class="rounded-lg"/>
                        </CardContent>
                        <CardFooter>
                            <p>Hot swappable split keyboard made entirely from scratch. Includes nice!nano MCUs, wireless communication, and ZMK firmware. My 
                                completely open-source take on the UM-70.</p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href = https://github.com/shreya-0718/dragon>
            <Card className="bg-darkblue w-auto hover:bg-middlestblue">
                <CardHeader>
                    <CardTitle>A Drawing Robot</CardTitle>
                    <CardDescription>Completed - December 2025</CardDescription>
                </CardHeader>
                <CardContent>
                    <Image src={ robotarm0 } alt="robot arm" class="rounded-lg"/>
                </CardContent>
                <CardFooter>
                    <p>Used LeRobot and Hugging Face along with the SO-101 robot arm for training 
                        and inference using AMD's cloud with an aim to create a robot 
                        that mimics human drawings</p>
                </CardFooter>
            </Card>
        </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href=https://github.com/nano13579/rp2040-devboard>
                    <Card className="bg-darkblue w-auto hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>RP2040 Dev Board</CardTitle>
                            <CardDescription>Completed - December 2025</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Image src={ devboard0 } alt="dev board" class="rounded-lg"/>
                        </CardContent>
                        <CardFooter>
                            <p>An RP2040 devboard with a small TSL2591 light sensor!</p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href=https://github.com/nano13579/narwhal>
                    <Card className="bg-darkblue w-auto hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>Macropad</CardTitle>
                            <CardDescription>Completed - May 2025</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Image src={ macropad0 } alt="macropad image" class="rounded-lg"/>
                        </CardContent>
                        <CardFooter>
                            <p>A little mini keyboard, and my first
                                hardware project and exposure to ECAD!
                            </p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href=https://github.com/nano13579/boxcar>
                    <Card className="bg-darkblue w-auto hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>Boxcar</CardTitle>
                            <CardDescription>Completed - July 2025</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Image src={ car0 } alt="car image" class="rounded-lg"/>
                        </CardContent>
                        <CardFooter>
                            <p>Wireless RC Car controlled via hand movements recorded 
                                w/ accelerometer, data is sent using I2C communication 
                                to RP2040 microcontroller</p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href=https://github.com/nano13579/emfi-board>
                    <Card className="bg-darkblue w-auto border border-4 hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>Custom EMFI Tool</CardTitle>
                            <CardDescription>In Progress</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Image src={ emfi } alt="emfi image" class="rounded-lg"/>
                        </CardContent>
                        <CardFooter>
                            <p>A custom RP2040 based electromagentic fault injection tool. 
                                Equips the LT3751 high voltage controller and (perhaps) an inbuilt
                            multi layer PCB coil.</p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href=https://github.com/nano13579/quadcopter/tree/main>
                    <Card className="bg-darkblue w-auto border border-4 hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>Quadcopter</CardTitle>
                            <CardDescription>In Progress</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Image src={ quadcopter } alt="quadcopter image" class="rounded-lg"/>
                        </CardContent>
                        <CardFooter>
                            <p>Drone FC using the STM32H7 and Ardupilot!</p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <div class="break-inside-avoid mb-6">
                <a href = https://github.com/nano13579/design-challenge>
                    <Card className="bg-darkblue w-auto hover:bg-middlestblue">
                        <CardHeader>
                            <CardTitle>Secure Bootloader System</CardTitle>
                            <CardDescription>Completed - June 2026</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <Image src={ bootloader } alt="bootloader image" class="rounded-lg"/>
                        </CardContent>
                        <CardFooter>
                            <p> Designed w/ my team @ BWSI for the TM4C123GXL MCU. Secured using the ChaCha20-Poly1305 symmetric stream cipher
                                and the Ed25519 signing algorithm. Attempted attacks against other teams using EMFI, DPA, Bus Pirate.
                            </p>
                        </CardFooter>
                    </Card>
                </a>
            </div>
            <!-- <div class="break-inside-avoid mb-6">
                    <Card className="bg-darkblue w-auto border border-4">
                        <CardHeader>
                            <CardTitle>Radii Script</CardTitle>
                            <CardDescription>In Progress</CardDescription>
                        </CardHeader>
                        <CardFooter>
                            <p>Using Robert Nydstrom's, "Crafting Interpreters"
                        as a guideline to implement a fully functional scripting language. Trying to make 
                    this entirely in Neovim!</p>
                        </CardFooter>
                    </Card>
            </div> -->
        </div>
    </body>
</html>